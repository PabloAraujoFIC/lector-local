{
  "name": "lector-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace @lector/desktop -- dev",
    "build": "npm run build --workspace @lector/desktop && npm run build --workspace @lector/extension",
    "desktop:build": "npm run tauri --workspace @lector/desktop -- build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/webextension-polyfill": "^0.12.3",
    "eslint": "^9.39.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.1.11"
  }
}
