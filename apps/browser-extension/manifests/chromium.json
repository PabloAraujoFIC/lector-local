{
  "manifest_version": 3,
  "name": "Lector Local",
  "version": "0.1.0",
  "description": "Escucha selecciones y artículos con el motor TTS de tu dispositivo.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Lector Local" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
