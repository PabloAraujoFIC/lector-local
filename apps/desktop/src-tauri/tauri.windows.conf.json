{
  "bundle": {
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "resources": {
      "runtime-windows/": "core/"
    }
  }
}
